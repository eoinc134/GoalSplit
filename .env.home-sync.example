# Copy this file to .env.home-sync (gitignored) and fill in real values.
# Used by scripts/home-garmin-sync.ps1 for the scheduled home-based Garmin
# sync — see README's "Home-based Garmin sync" section for why this runs
# from a home machine instead of Railway.

GARMIN_EMAIL=
GARMIN_PASSWORD=

# Railway's PUBLIC Postgres connection string, not the internal
# postgres.railway.internal one the deployed API service uses — that
# hostname only resolves inside Railway's own network. Find this on
# Railway's Postgres service's "Connect" tab (public TCP proxy / a
# proxy.rlwy.net hostname), not the Variables tab's internal DATABASE_URL.
DATABASE_URL=
