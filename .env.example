# Docker Compose — the local Postgres (port 5433) and the research snapshot
# database (port 5434). Pick any values; apps/api/.env's DATABASE_URL must
# use the same ones:
#   DATABASE_URL=postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:5433/<POSTGRES_DB>
POSTGRES_DB=goalsplit
POSTGRES_USER=goalsplit
POSTGRES_PASSWORD=
