PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# PostgreSQL — for local dev use docker-compose (see root docker-compose.yml)
DATABASE_URL=

# Strava API — create an app at https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:3001/api/auth/strava/callback

# USDA FoodData Central — free key, instant signup: https://fdc.nal.usda.gov/api-key-signup.html
# Falls back to the shared "DEMO_KEY" (tightly rate-limited) if unset.
USDA_API_KEY=
