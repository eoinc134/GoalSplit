PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# PostgreSQL — for local dev use docker-compose (see root docker-compose.yml)
DATABASE_URL=

# Strava API — create an app at https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:3001/api/auth/strava/callback

# Garmin health data (unofficial, via garmy — pip install garmy[localdb]).
# MFA must be disabled on this account; the sync CLI is non-interactive.
GARMIN_EMAIL=
GARMIN_PASSWORD=
GARMY_DB_PATH=./garmin-health.db
