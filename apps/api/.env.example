PORT=3001
NODE_ENV=development

# PostgreSQL — for local dev use docker-compose (see root docker-compose.yml)
DATABASE_URL=

# Strava API — create an app at https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# The WEB app's callback route — the web app runs the sign-in flow.
STRAVA_REDIRECT_URI=http://localhost:3000/api/auth/strava/callback

# Garmin Personal API key — Garmin Connect → account settings → Personal API
# Key. Keys expire (30 days to a year); create a new one when sync reports it
# rejected. See docs/SETUP.md.
GARMIN_API=

# --- Security (all three are required when NODE_ENV=production) ---------------
# Shared secret the web app (and MCP trainer) send as x-api-key. Same value as
# API_KEY in apps/web. Leave empty locally to run the API open.
#   openssl rand -hex 32
API_KEY=
# 32 bytes, hex or base64 — encrypts stored Strava tokens. Losing it means
# reconnecting Strava. Empty locally = tokens stored unencrypted.
#   openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
# The only Strava athlete allowed to sign in (your numeric id, from
# strava.com/athletes/<id>). Empty locally = the first athlete to connect.
ALLOWED_STRAVA_ATHLETE_ID=
