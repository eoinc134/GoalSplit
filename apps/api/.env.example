PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# PostgreSQL — for local dev use docker-compose (see root docker-compose.yml)
DATABASE_URL=

# Strava API — create an app at https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:3001/api/auth/strava/callback

# Garmin credentials live in .env.home-sync (repo root) — Garmin sync runs
# from a home machine, not this API. See docs/SETUP.md.
