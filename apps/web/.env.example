# Server-side only — none of these reach the browser. The browser talks to
# this app's own /api/* proxy, which forwards to the API with API_KEY.
API_URL=http://localhost:3001/api

# Leave both empty locally to skip sign-in. Required in production (the app
# fails closed without SESSION_SECRET).
# Same value as API_KEY in apps/api.
API_KEY=
# Signs session cookies; rotating it signs you out.  openssl rand -hex 32
SESSION_SECRET=

# Sentry (optional) — see docs/OBSERVABILITY.md. goalsplit-web DSN for the
# server (SENTRY_DSN) and the browser (NEXT_PUBLIC_, baked in at build time).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Performance tracing sample rates (e.g. 0.1). Default 0 (off).
SENTRY_TRACES_SAMPLE_RATE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
# Build time only, for source-map upload. SENTRY_AUTH_TOKEN is a secret.
SENTRY_ORG=eoin-costello
SENTRY_PROJECT=goalsplit-web
SENTRY_AUTH_TOKEN=
